{
  "name": "@crashwif/crash-math",
  "version": "0.1.0",
  "private": true,
  "description": "The single crash-game maths implementation for Crashwif (free layer and casino modules)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./free": {
      "types": "./dist/free.d.ts",
      "default": "./dist/free.js"
    },
    "./casino": {
      "types": "./dist/casino.d.ts",
      "default": "./dist/casino.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "default": "./dist/chain.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "vectors:update": "UPDATE_VECTORS=1 vitest run test/vectors.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
